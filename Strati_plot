library(readxl)
library(rioja)

file <- "El_Triunfo_26.xlsx"

# Tephra and zones
tephra <- data.frame(
  letter=c("A","B","C","D","E","F","G"),
  top=c(264,251,211,201,170,126,47),
  bottom=c(280,260,238,204,182,140,50)
)

dz <- data.frame(
  depth=c(109,204,272.5,372),
  z=c(106,172,196,288),
  calBP=c(486,700,889,1598)
)

event_z <- function(d){
  z <- d
  x <- tephra[order(tephra$top),]
  shift <- 0
  for(i in seq_len(nrow(x))){
    inside <- d>=x$top[i] & d<=x$bottom[i]
    below <- d>x$bottom[i]
    z[inside] <- x$top[i]-shift
    z[below] <- z[below]-(x$bottom[i]-x$top[i])
    shift <- shift+(x$bottom[i]-x$top[i])
  }
  z
}

# Age model
age_model <- data.frame(
  depth=c(
    0,32,47,55,69,76,98,109,120,126,140,156,170,184,190,
    202,204,206,208.5,210,220,230,255.5,265,272.5,280,284,
    290,300,310,320,336,350,353.5,362,372,382,384.5,408,
    578.5,700
  ),
  calBP=c(
    -62,69,131,157,253,301,451,486,520,545,545,586,631,
    640,664,700,700,707,714,724,729,729,846,889,889,889,
    943,988,1062,1137,1211,1329,1433,1456,1523,1598,1674,
    1690,2022,4379,5085
  )
)

age_model$z <- event_z(age_model$depth)
age_nodes <- aggregate(calBP~z,age_model,mean)
age_nodes <- age_nodes[order(age_nodes$z),]
age_from_z <- approxfun(age_nodes$z,age_nodes$calBP,rule=2)

# Diatom data
diat <- as.data.frame(
  read_excel(file,"%_2026",range="B2:AF102")
)

names(diat)[1] <- "Taxon"
clean <- function(x) gsub("\\s+"," ",trimws(x))

diat <- diat[
  !is.na(diat$Taxon)&
    trimws(diat$Taxon)!=""&
    !grepl("total",diat$Taxon,ignore.case=TRUE),
]

diat$Taxon <- make.unique(clean(diat$Taxon))
rownames(diat) <- diat$Taxon
diat$Taxon <- NULL
diat[] <- lapply(diat,as.numeric)

spec <- as.data.frame(t(diat))
depth <- as.numeric(gsub("[^0-9.]","",rownames(spec)))

keep <- is.finite(depth)
spec <- spec[keep,,drop=FALSE]
depth <- depth[keep]

ord <- order(depth)
spec <- spec[ord,,drop=FALSE]
depth <- depth[ord]

minimum_depth <- min(depth)
maximum_depth <- max(depth)

# Zones
zones <- cut(
  depth,
  breaks=c(-Inf,109,204,272.5,372,Inf),
  labels=c("Zone 1","Zone 2","Zone 3","Zone 4","Zone 5"),
  right=FALSE
)

# CONISS
coniss_keep <- apply(spec,2,max,na.rm=TRUE)>=2&
  colSums(spec>0,na.rm=TRUE)>=2

comm <- spec[,coniss_keep,drop=FALSE]

ma.chclust <- chclust(
  dist(sqrt(comm/100),method="euclidean"),
  method="coniss"
)

# Ecological groups
eco <- as.data.frame(read_excel(file,"E_class"))
eco$Species <- clean(eco$Species)
eco$Habitat <- trimws(as.character(eco$Habitat))

group_order <- c(
  "Planktonic",
  "Benthic-planktonic",
  "Benthic",
  "Benthic-aerophilic",
  "Aerophilic",
  "Uncertain"
)

eco$Habitat[
  is.na(eco$Habitat)|
    eco$Habitat==""|
    eco$Habitat=="Unknown"|
    !eco$Habitat%in%group_order
] <- "Uncertain"

eco <- eco[!duplicated(eco$Species),]
group_lookup <- setNames(eco$Habitat,eco$Species)

# Taxa >=5%
taxa_keep <- apply(spec,2,max,na.rm=TRUE)>=5
spec_plot <- spec[,taxa_keep,drop=FALSE]

plot_meta <- data.frame(
  Taxon=colnames(spec_plot),
  Maximum=apply(spec_plot,2,max,na.rm=TRUE)
)

plot_meta$Lookup <- sub("\\.[0-9]+$","",plot_meta$Taxon)
plot_meta$Group <- unname(group_lookup[plot_meta$Lookup])
plot_meta$Group[is.na(plot_meta$Group)] <- "Uncertain"
plot_meta$group_number <- match(plot_meta$Group,group_order)

plot_meta <- plot_meta[
  order(plot_meta$group_number,-plot_meta$Maximum),
]

spec_disp <- spec_plot[,plot_meta$Taxon,drop=FALSE]
ex <- apply(spec_disp,2,max,na.rm=TRUE)<=10

group_ranges <- lapply(
  group_order,
  function(g) which(plot_meta$Group==g)
)

names(group_ranges) <- group_order
group_ranges <- group_ranges[lengths(group_ranges)>0]

# Tephra
tephra_band_fun <- function(x,y,i,nm){
  usr <- par("usr")
  for(j in seq_len(nrow(tephra))){
    rect(
      usr[1],tephra$top[j],usr[2],tephra$bottom[j],
      col=adjustcolor("red",alpha.f=.10),
      border=NA
    )
  }
}

diatom_overlay_fun <- function(x,y,i,nm){
  usr <- par("usr")
  
  for(j in seq_len(nrow(tephra))){
    abline(
      h=c(tephra$top[j],tephra$bottom[j]),
      col=adjustcolor("red",alpha.f=.65),
      lwd=.8
    )
    
    if(i==1)
      text(
        usr[1],
        mean(c(tephra$top[j],tephra$bottom[j])),
        tephra$letter[j],
        pos=4,cex=.70,font=2,col="firebrick"
      )
  }
  
  abline(h=dz$depth,col="grey30",lty=2,lwd=1.3)
}

# Axes
draw_left_axes <- function(y_bottom,y_top){
  ticks <- sort(unique(depth))
  z_ticks <- event_z(ticks)
  age_ticks <- age_from_z(z_ticks)
  
  par(
    fig=c(.035,.125,0,1),
    plt=c(.96,.99,y_bottom,y_top),
    new=TRUE,
    xpd=NA
  )
  
  plot(
    NA,
    xlim=c(0,1),
    ylim=c(maximum_depth,minimum_depth),
    axes=FALSE,xlab="",ylab="",
    xaxs="i",yaxs="i"
  )
  
  axis(2,at=ticks,labels=ticks,line=0,las=2,cex.axis=.48,tck=-.015)
  axis(2,at=ticks,labels=round(z_ticks,1),line=3,las=2,cex.axis=.48,tck=-.015)
  axis(2,at=ticks,labels=round(age_ticks),line=6,las=2,cex.axis=.48,tck=-.015)
  
  mtext("Core depth (cm)",2,line=2.1,cex=.68)
  mtext("Event-free z (cm)",2,line=5.1,cex=.68)
  mtext("Corrected age (cal BP)",2,line=8.1,cex=.68)
}

# Ecological brackets
add_ecology_brackets <- function(dgram){
  oldpar <- par(no.readonly=TRUE)
  on.exit(par(oldpar))
  
  for(g in names(group_ranges)){
    ids <- group_ranges[[g]]
    x_left <- dgram$figs[[min(ids)]][1]
    x_right <- dgram$figs[[max(ids)]][2]
    
    par(
      fig=c(x_left,x_right,0,1),
      mar=c(0,0,0,0),
      new=TRUE,
      xpd=NA
    )
    
    plot(
      NA,xlim=c(0,1),ylim=c(0,1),
      axes=FALSE,xlab="",ylab="",
      xaxs="i",yaxs="i"
    )
    
    segments(.02,.92,.98,.92,lwd=1.15)
    segments(.02,.92,.02,.90,lwd=1.15)
    segments(.98,.92,.98,.90,lwd=1.15)
    text(.5,.945,g,cex=.66,font=2)
  }
}

# Plot
draw_diatoms <- function(){
  y_bottom <- .10
  y_top <- .69
  
  dgram <- strat.plot(
    spec_disp,
    yvar=depth,
    orig.fig=c(.125,1,0,1),
    xLeft=.01,
    xRight=.99,
    yBottom=y_bottom,
    yTop=y_top,
    y.rev=TRUE,
    ylim=c(minimum_depth,maximum_depth),
    y.axis=FALSE,
    ylabel="",
    plot.line=FALSE,
    plot.poly=TRUE,
    plot.bar=TRUE,
    col.bar="black",
    col.poly="grey85",
    col.poly.line="black",
    lwd.poly=1,
    scale.percent=TRUE,
    xSpace=.0015,
    x.pc.inc=5,
    x.pc.lab=TRUE,
    x.pc.omit0=TRUE,
    srt.xlabel=84,
    cex.xlabel=.58,
    las=2,
    exag=ex,
    col.exag="grey50",
    exag.mult=3,
    exag.alpha=.5,
    clust=ma.chclust,
    clust.width=.085,
    fun1=tephra_band_fun,
    fun2=diatom_overlay_fun,
    title="Diatom relative abundance"
  )
  
  draw_left_axes(y_bottom,y_top)
  add_ecology_brackets(dgram)
  invisible(dgram)
}

